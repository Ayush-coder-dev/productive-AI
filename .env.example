# Local LLM
OLLAMA_MODEL=llama3:8b
OLLAMA_HOST=http://localhost:11434

# Telegram mobile chat interface
# 1) Create bot via @BotFather and paste token below.
TELEGRAM_BOT_TOKEN=

# 2) Optional but recommended for privacy: set your own chat ID.
#    Start bot once from Telegram, then run /id to see the number.
TELEGRAM_CHAT_ID=

# Proactive intelligence tuning
# Max proactive nudges per day (urgent signals can exceed by 1).
PROACTIVE_DAILY_LIMIT=3

# Minimum gap between proactive nudges for non-urgent situations.
PROACTIVE_COOLDOWN_MINUTES=120

# Quiet hours window (24h local time): less interruption unless urgent.
PROACTIVE_NIGHT_START_HOUR=22
PROACTIVE_NIGHT_END_HOUR=7
